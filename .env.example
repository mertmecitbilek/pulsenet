# ============================================================
# PulseNet — Environment Variables
# Copy this file to .env and fill in the values.
# .env holds real secrets and is git-ignored — never commit it.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=pulsenet
POSTGRES_PASSWORD=changeme_choose_a_db_password
POSTGRES_DB=pulsenet
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async SQLAlchemy connection string (used by backend)
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above
DATABASE_URL=postgresql+asyncpg://pulsenet:changeme_choose_a_db_password@db:5432/pulsenet

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Generate with: openssl rand -base64 36
SECRET_KEY=changeme_generate_a_long_random_string
ENVIRONMENT=development   # development | production

# Shared secret agents send in the X-Agent-Key header. Change it in production.
# Generate with: openssl rand -base64 24
AGENT_API_KEY=changeme_generate_a_random_agent_key

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Tek kullanıcılı kurulum: ilk hesap açıldıktan sonra kayıt kapanır.
# Ek kullanıcılara (viewer) izin vermek için true yapın.
ALLOW_MULTIPLE_USERS=false

# --- Agent ---
# URL of the backend API (resolvable from the agent container)
AGENT_BACKEND_URL=http://backend:8000
# How often (seconds) the agent collects and sends metrics
AGENT_COLLECT_INTERVAL=10
# The host record that this agent reports under (set after first /api/hosts POST)
AGENT_HOST_ID=

# --- Alert Thresholds ---
ALERT_CPU_THRESHOLD=90       # percent
ALERT_MEMORY_THRESHOLD=85    # percent
ALERT_DISK_THRESHOLD=80      # percent

# --- Veri saklama ---
# Bu günden eski metrikler, kontrol sonuçları ve kapanmış alarmlar silinir (0 = kapalı)
DATA_RETENTION_DAYS=14

# --- Frontend ---
# NEXT_PUBLIC_* variables are embedded into the browser bundle at BUILD time.
# Use the URL that the end-user's browser can reach (usually localhost in dev).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
